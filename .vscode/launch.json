{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: Debug Serial K-Means",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/src/kmeans",
      "args": [
        "--input", "${workspaceFolder}/datasets/mouse_500x2.csv",
        "--output", "${workspaceFolder}/src/output.csv",
        "--k", "3",
        "--repetitions", "10",
        "--seed", "1338",
        "--trace", "${workspaceFolder}/src/clustertrace.csv",
        "--centroidtrace", "${workspaceFolder}/src/centroidtrace.csv"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/src",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}