{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-O0",
                "-std=c++11",
                "${workspaceFolder}/src/main_startcode.cpp",
                "${workspaceFolder}/src/rng.cpp",
                "-I${workspaceFolder}/src",
                "-o",
                "${workspaceFolder}/src/kmeans"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}